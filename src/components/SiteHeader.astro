---
// Cabecera del sitio, compartida entre páginas.
---

<header class="sticky top-0 z-40 border-b border-white/40 bg-white/60 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
    <a
      href="/"
      aria-label="Nibiru Paint — inicio"
      class="rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ochre"
    >
      <img src="/logo.webp" alt="Nibiru Paint" width="160" height="42" class="h-8 w-auto" />
    </a>
    <a
      href="/#categorias"
      class="rounded-full bg-ink px-4 py-2 text-sm font-medium text-paper transition hover:bg-ink/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ochre"
    >
      Explorar dibujos
    </a>
  </div>
</header>
