---
// Pie del sitio, compartido entre páginas.
const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-6xl px-6 py-12 text-center">
  <img src="/logo.webp" alt="Nibiru Paint" width="160" height="42" class="mx-auto h-8 w-auto opacity-90" />
  <p class="mt-4 text-sm text-ink/60">
    Dibujos para colorear gratis para niños. Descárgalos en PDF o imagen.
  </p>
  <p class="mt-1 text-xs text-ink/45">© {year} Nibiru Paint</p>
</footer>
