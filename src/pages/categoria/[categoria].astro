---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { CATEGORIES, getDibujos, prettify, type CategoryMeta } from '../../lib/dibujos';

export function getStaticPaths() {
  return CATEGORIES.map((meta) => ({
    params: { categoria: meta.slug },
    props: { meta },
  }));
}

const { meta } = Astro.props as { meta: CategoryMeta };
const dibujos = getDibujos(meta.slug);
const total = dibujos.length;

// Agrupa por tema (subcarpeta). Los que no tienen tema van juntos al final.
const grupos = new Map<string, typeof dibujos>();
for (const d of dibujos) {
  const key = d.tema;
  if (!grupos.has(key)) grupos.set(key, []);
  grupos.get(key)!.push(d);
}
const gruposArr = [...grupos.entries()].sort((a, b) => {
  if (a[0] === '') return 1;
  if (b[0] === '') return -1;
  return a[0].localeCompare(b[0], 'es');
});

const nombre = meta.name;
const nombreLower = nombre.toLowerCase();
const title = `Dibujos de ${nombre} para colorear · Nibiru Paint`;
const description = `${total} dibujos de ${nombreLower} para colorear gratis. Descárgalos en PDF o imagen e imprímelos para pintar.`;

const base = Astro.site?.href ?? `${Astro.url.origin}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: base },
    {
      '@type': 'ListItem',
      position: 2,
      name: nombre,
      item: new URL(`/categoria/${meta.slug}`, base).href,
    },
  ],
};
---

<Layout title={title} description={description}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <SiteHeader />

  <main class="mx-auto max-w-6xl px-6">
    <!-- Migas -->
    <nav aria-label="Migas de pan" class="pt-6 text-sm text-ink/60">
      <ol class="flex items-center gap-2">
        <li>
          <a href="/" class="hover:text-ochre focus-visible:outline-none focus-visible:underline">Inicio</a>
        </li>
        <li aria-hidden="true">›</li>
        <li class="font-medium text-ink/80" aria-current="page">{nombre}</li>
      </ol>
    </nav>

    <!-- Encabezado de categoría -->
    <header class="pt-4 pb-8">
      <p class="text-sm font-semibold tracking-wide text-ochre uppercase">
        <span aria-hidden="true">{meta.emoji}</span> Categoría
      </p>
      <h1 class="font-serif mt-2 text-4xl font-medium tracking-tight text-ink sm:text-5xl">
        Dibujos de {nombre} para colorear
      </h1>
      <p class="mt-3 max-w-2xl text-[17px] leading-relaxed text-ink/70">
        {total} dibujos de {nombreLower} para colorear gratis. Descarga cada uno
        en <strong class="font-semibold text-ink">PDF</strong> para imprimir o en
        imagen, y ¡a pintar!
      </p>
    </header>

    <!-- Galería agrupada por tema -->
    {gruposArr.map(([tema, items]) => (
      <section class="pb-10">
        {tema !== '' && (
          <h2 class="font-serif mb-4 text-2xl font-medium tracking-tight text-ink">
            {prettify(tema)}
          </h2>
        )}
        <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          {items.map((d) => (
            <li class="min-w-0">
              <figure class="rounded-2xl bg-white/70 p-3 shadow-sm ring-1 ring-black/5">
                <div class="aspect-square overflow-hidden rounded-xl bg-white">
                  <img
                    src={d.img}
                    alt={`Dibujo de ${prettify(d.tema || nombre).toLowerCase()} para colorear`}
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-contain"
                  />
                </div>
                <figcaption class="sr-only">{d.nombre}</figcaption>
                <div class="mt-3 flex gap-2">
                  <a
                    href={d.img}
                    download
                    class="flex-1 rounded-full bg-ink/5 px-3 py-1.5 text-center text-xs font-medium text-ink/80 transition hover:bg-ink/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink"
                  >
                    Imagen
                  </a>
                  <a
                    href={d.pdf}
                    download
                    class="flex-1 rounded-full bg-ochre px-3 py-1.5 text-center text-xs font-medium text-white transition hover:bg-ochre-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink"
                  >
                    PDF
                  </a>
                </div>
              </figure>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>

  <SiteFooter />
</Layout>
