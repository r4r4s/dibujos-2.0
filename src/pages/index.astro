---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Nibiru Paint">
	<main class="mx-auto grid min-h-screen max-w-3xl place-items-center px-6 py-12 text-center">
		<div>
			<p class="text-sm font-medium tracking-wide text-ochre uppercase">
				Nibiru Paint
			</p>
			<h1 class="font-serif mt-2 text-4xl font-medium tracking-tight">
				Próximamente
			</h1>
			<p class="mt-3 text-[15px] leading-relaxed text-ink/70">
				Aquí irá la aplicación.
			</p>
		</div>
	</main>
</Layout>
